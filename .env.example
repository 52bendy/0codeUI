# InTimeUI 后端服务环境变量样例（复制为 .env 供本地开发使用）
# 注意：.env 已被 .gitignore 忽略，严禁提交任何真实密钥。

# 运行环境：dev / prod
APP_ENV=dev

# 监听地址与端口
APP_HOST=0.0.0.0
APP_PORT=8080

# 日志级别与格式（dev 默认 pretty，prod 默认 json）
LOG_LEVEL=info
# LOG_FORMAT=pretty

# 开发鉴权模式：接受 Authorization: Bearer dev:<user_id>（仅限本地联调；prod 禁止开启）
AUTH_DEV_MODE=true

# 静态令牌表（生产使用），格式：token1:user_id1,token2:user_id2
# AUTH_STATIC_TOKENS=

# 基础限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# 请求处理超时（秒）
REQUEST_TIMEOUT_SECS=30

# 数据库连接串（SQLite；文件不存在时自动创建，父目录会自动创建）
# 测试可用 sqlite::memory:
DATABASE_URL=sqlite://data/intimeui.db

# ---- UI 生成模型推理（REQ-202610-1181）----
# 是否启用模型接口
MODEL_ENABLED=true
# 提供者：mock（仅开发/测试）| openai_compatible（vLLM / Ollama / DeepSeek）
MODEL_PROVIDER=mock
# OpenAI 兼容服务地址（不要带 /chat/completions）
MODEL_BASE_URL=http://127.0.0.1:8000/v1
# 服务端密钥（本机 vLLM 可留空；严禁提交真实密钥）
MODEL_API_KEY=
# 主模型与备用模型链（逗号分隔）
MODEL_NAME=Qwen2.5-Coder-7B-Instruct-AWQ
MODEL_FALLBACKS=
# 灰度模型与流量百分比（0–100）
# MODEL_CANARY_MODEL=DeepSeek-Coder-V2-Lite-Instruct
MODEL_CANARY_PERCENT=0
# 超时与并发（毫秒 / 个数）
MODEL_REQUEST_TIMEOUT_MS=1500
MODEL_STREAM_TIMEOUT_MS=30000
MODEL_CONNECT_TIMEOUT_MS=300
MODEL_MAX_CONCURRENCY=4
MODEL_MAX_QUEUE=64
MODEL_QUEUE_TIMEOUT_MS=1500
MODEL_MAX_RETRIES=1
MODEL_RETRY_BACKOFF_MS=100
# 生成参数
MODEL_MAX_TOKENS=2048
MODEL_TEMPERATURE=0.2
# 成本估算（美元 / 千 token；自托管填 0）
MODEL_PRICE_INPUT_PER_1K=0
MODEL_PRICE_OUTPUT_PER_1K=0
# mock 延迟（毫秒，仅开发/测试）
MODEL_MOCK_LATENCY_MS=30
MODEL_MOCK_STREAM_DELAY_MS=5

# ---- 用户画像引擎（REQ-202610-1176）----
# EWMA 基础平滑系数 / 上限
PROFILE_EWMA_ALPHA=0.15
PROFILE_MAX_ALPHA=0.6
# 自动更新最小间隔（秒）
PROFILE_MIN_UPDATE_INTERVAL_SECS=60
# 单次刷新最多处理样本数
PROFILE_MAX_OBSERVATIONS=1000

# ---- 偏好对齐数据管道（REQ-202610-1188）----
# 管理端令牌：配置后 list / review / stats / sample / export 需携带
# X-Preference-Token；生产环境必填（>= 16 字符）
# PREFERENCE_ADMIN_TOKEN=
# 入库最低质量分 / 自动通过质量分（0–1）
PREFERENCE_MIN_QUALITY=0.5
PREFERENCE_AUTO_ACCEPT_QUALITY=0.8
# prompt 最大字符数 / 单段 HTML 最大字节数 / 元数据最大字节数
PREFERENCE_MAX_PROMPT_CHARS=8000
PREFERENCE_MAX_HTML_BYTES=262144
PREFERENCE_MAX_METADATA_BYTES=8192
# 单次导出最大记录数 / 单用户配额 / 单场景配额
PREFERENCE_EXPORT_MAX_RECORDS=5000
PREFERENCE_EXPORT_MAX_PER_USER=50
PREFERENCE_EXPORT_MAX_PER_SCENE=1000
# 导出用户哈希盐（生产环境必填，>= 16 字符；严禁提交真实值）
PREFERENCE_USER_HASH_SALT=dev-only-change-me

# ---- AI 生成管线编排（REQ-202610-1185）----
# 是否启用动态生成管线（false 时全部走静态模板）
PIPELINE_ENABLED=true
# 端到端时间预算（毫秒），首屏感知硬约束 ≤1500
PIPELINE_TIMEOUT_MS=1500
# 预留给静态模板兜底的时间（毫秒）
PIPELINE_FALLBACK_RESERVE_MS=50
# 响应缓存（相同输入命中缓存，跳过模型调用）
PIPELINE_CACHE_ENABLED=true
PIPELINE_CACHE_TTL_SECS=300
PIPELINE_CACHE_MAX_ENTRIES=256
# 管线内输出混淆开关与强度：off / basic / standard（实际强度取 UI_OBFUSCATION_LEVEL）
PIPELINE_OBFUSCATION_LEVEL=standard

# ---- 输出混淆（REQ-202610-1184）----
# 强度：off / basic / standard / aggressive
UI_OBFUSCATION_ENABLED=true
UI_OBFUSCATION_LEVEL=standard
UI_OBFUSCATION_SESSION_TTL_SECS=1800
UI_OBFUSCATION_MAX_SESSIONS=1000
UI_OBFUSCATION_MIN_IDENTIFIER_COVERAGE=0.8
