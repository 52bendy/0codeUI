# InTimeUI 后端服务环境变量样例（复制为 .env 供本地开发使用）
# 注意：.env 已被 .gitignore 忽略，严禁提交任何真实密钥。

# 运行环境：dev / prod
APP_ENV=dev

# 监听地址与端口
APP_HOST=0.0.0.0
APP_PORT=8080

# 日志级别与格式（dev 默认 pretty，prod 默认 json）
LOG_LEVEL=info
# LOG_FORMAT=pretty

# 开发鉴权模式：接受 Authorization: Bearer dev:<user_id>（仅限本地联调；prod 禁止开启）
AUTH_DEV_MODE=true

# 静态令牌表（生产使用），格式：token1:user_id1,token2:user_id2
# AUTH_STATIC_TOKENS=

# 基础限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# 请求处理超时（秒）
REQUEST_TIMEOUT_SECS=30

# 数据库连接串（SQLite；文件不存在时自动创建，父目录会自动创建）
# 测试可用 sqlite::memory:
DATABASE_URL=sqlite://data/intimeui.db

# 用户画像引擎（REQ-202610-1176）
# EWMA 基础平滑系数 / 上限
PROFILE_EWMA_ALPHA=0.15
PROFILE_MAX_ALPHA=0.6
# 自动更新最小间隔（秒）
PROFILE_MIN_UPDATE_INTERVAL_SECS=60
# 单次刷新最多处理样本数
PROFILE_MAX_OBSERVATIONS=1000

# Few-Shot 模版检索（REQ-202610-1183）
FEW_SHOT_ENABLED=true
# 单次返回片段数上限（1~10）
FEW_SHOT_TOP_K=3
# Prompt 片段 token 预算（64~8000）
FEW_SHOT_TOKEN_BUDGET=1200
# 最低相关性阈值（0~1），低于该值安全降级
FEW_SHOT_MIN_SCORE=0.15
# 单片段最大字符数（200~20000）
FEW_SHOT_MAX_SNIPPET_CHARS=4000
# 单场景候选集上限（1~1000）
FEW_SHOT_CANDIDATE_LIMIT=200
# 片段写接口管理令牌；设置后 POST 需携带 X-Few-Shot-Token
# FEW_SHOT_ADMIN_TOKEN=
